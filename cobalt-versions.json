{
  "cobalt": {
    "version": "27.lts.1",
    "repo": "https://github.com/youtube/cobalt.git",
    "ref": "27.lts.1",
    "starboard_api_version": 16
  },
  "platforms": {
    "aosp-arm": {
      "family": "aosp",
      "binary_variant": "arm",
      "os": "Android (AOSP)",
      "cpu": "ARM",
      "architecture": "armv7",
      "graphics": "EGL + OpenGL ES 2.0",
      "description": "Android TV (ARM 32-bit). Primary target.",
      "output": "apks/cobalt.apk",
      "package": "dev.cobalt.coat"
    },
    "aosp-arm64": {
      "family": "aosp",
      "binary_variant": "arm64",
      "os": "Android (AOSP)",
      "cpu": "ARM 64-bit",
      "architecture": "armv8",
      "graphics": "EGL + OpenGL ES 2.0",
      "description": "Android TV (ARM 64-bit).",
      "output": "apks/cobalt.apk",
      "package": "dev.cobalt.coat"
    },
    "aosp-x86": {
      "family": "aosp",
      "binary_variant": "x86",
      "os": "Android (AOSP)",
      "cpu": "x86",
      "architecture": "x86",
      "graphics": "EGL + OpenGL ES 2.0",
      "description": "Android x86 (emulator/testing).",
      "output": "apks/cobalt.apk",
      "package": "dev.cobalt.coat"
    }
  },
  "build": {
    "default_type": "gold",
    "supported_types": ["debug", "devel", "qa", "gold"],
    "app_url": "https://bigscreen.cinelartv.lat",
    "build_target": "cobalt_loader"
